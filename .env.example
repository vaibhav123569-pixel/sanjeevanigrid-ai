# Optional URL for the FastAPI service in deployments where /api is not rewritten to Cloud Run.
VITE_API_BASE_URL=

# Optional Google Maps JavaScript API key. Leave blank to use Leaflet + OpenStreetMap.
VITE_GOOGLE_MAPS_API_KEY=
VITE_GOOGLE_MAP_ID=

# Optional Firebase web config. These are public project identifiers, not server secrets.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MESSAGING_SENDER_ID=

# Backend only: never add this key to a VITE_ variable or frontend bundle.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
FIREBASE_PROJECT_ID=
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
